FROM python:3.11-slim

WORKDIR /srv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

COPY crm_core/pyproject.toml /srv/crm_core/pyproject.toml
RUN pip install --no-cache-dir -e /srv/crm_core

COPY crm_core /srv/crm_core
WORKDIR /srv/crm_core

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
