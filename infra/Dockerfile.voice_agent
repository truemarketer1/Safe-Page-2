FROM python:3.11-slim
WORKDIR /srv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY voice_agent/pyproject.toml /srv/voice_agent/pyproject.toml
RUN pip install --no-cache-dir -e /srv/voice_agent
COPY voice_agent /srv/voice_agent
WORKDIR /srv/voice_agent
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
