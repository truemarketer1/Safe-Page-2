FROM python:3.11-slim
WORKDIR /srv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY dm_engine/pyproject.toml /srv/dm_engine/pyproject.toml
RUN pip install --no-cache-dir -e /srv/dm_engine
COPY dm_engine /srv/dm_engine
WORKDIR /srv/dm_engine
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
