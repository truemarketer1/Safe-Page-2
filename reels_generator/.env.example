# Copy to `.env` and fill in your values.

# --- HeyGen ---
HEYGEN_API_KEY=your_heygen_api_key
HEYGEN_AVATAR_ID=your_instant_avatar_id
HEYGEN_VOICE_ID=your_cloned_voice_id

# --- Inputs/outputs ---
CORE_VIDEO_PATH=core_message.mp4
HOOKS_CSV_PATH=examples/hooks.example.csv
OUTPUT_DIR=output
CACHE_DIR=.hook_cache

# --- Video format (Reels default is 1080x1920 vertical) ---
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920

# --- Polling / concurrency ---
POLL_INTERVAL_SECONDS=5
POLL_TIMEOUT_SECONDS=600
MAX_PARALLEL_GENERATIONS=4
